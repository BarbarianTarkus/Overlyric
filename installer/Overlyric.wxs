<?xml version="1.0" encoding="utf-8"?>
<!--
  Overlyric per-user MSI authoring (WiX Toolset v6, schema v4).

  Build with installer\build-installer.ps1 (the single reproducible entry point) or, once the
  publish output exists, with:
      dotnet build installer\Overlyric.Installer.wixproj -c Release -p:OverlyricVersion=0.1.0

  Preprocessor variables supplied by the build:
      $(var.OverlyricVersion)  X.Y.Z product version (from src\Overlyric\Overlyric.csproj)
      $(var.PublishDir)        directory containing the published payload (Overlyric.exe, *.pdb)

  installer\Payload.wxs is generated by build-installer.ps1 from the actual publish directory
  (every file except *.pdb and except Overlyric.exe, which is authored here so that the
  CloseApplication custom action can be attached to it). It defines the PayloadExtras group.

  Contract notes:
  * Scope="perUser": no elevation, installs to %LOCALAPPDATA%\Programs\Overlyric.
  * ProductCode is intentionally NOT authored: WiX generates a fresh ProductCode per build so
    MajorUpgrade works between versions, while UpgradeCode stays fixed forever.
  * The payload is every published file except *.pdb (the 42 MB native PDB is not shipped).
  * Uninstall keeps %LOCALAPPDATA%\Overlyric (user config/cache) unless REMOVEDATA=1 is passed.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="Overlyric"
           Manufacturer="Overlyric"
           Version="$(var.OverlyricVersion)"
           UpgradeCode="{0D9C4E52-7B1A-4C63-9E28-6F5A3D1B8C47}"
           Scope="perUser"
           Compressed="yes"
           Language="1033"
           InstallerVersion="500">

    <SummaryInformation Description="Overlyric $(var.OverlyricVersion) (per-user installation)" Manufacturer="Overlyric" />

    <!-- Same UpgradeCode for every version: a newer build replaces an older one, an older build
         is refused with this message instead of silently corrupting the installed product. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Overlyric is already installed. Uninstall it first if you need to roll back." />

    <MediaTemplate EmbedCab="yes" />

    <!--
      Per-user installation, no elevation. Scope="perUser" marks the package LUA-capable (Summary
      Information Word Count bit 3, "elevation not required"), which is what makes Windows Installer
      pick the per-user context: files under the installing user's profile, per-user registry in HKCU.

      No ALLUSERS or MSIINSTALLPERUSER property is authored, deliberately. A UAC-compliant package
      ignores both, as the install log states verbatim:
        MSI_LUA: Package is marked as LUA installation capable with no elevation required
        MSIINSTALLPERUSER property is not valid for UAC compliant package. Ignoring the MSIINSTALLPERUSER property.
        PROPERTY CHANGE: Deleting ALLUSERS property. Its current value is '2'.
      Adding them would therefore only make the authoring claim something the installer does not honour.
    -->

    <!--
      No ARPSYSTEMCOMPONENT and no hand-written Uninstall key: the Apps & Features entry for the
      product is the one Windows Installer registers itself. Measured on a clean machine, installing
      from a non-elevated shell writes a complete registration (DisplayName, DisplayVersion,
      Publisher, UninstallString, ModifyPath, InstallLocation from ARPINSTALLLOCATION below, and an
      EstimatedSize derived from the File table) and Programs and Features lists Overlyric once.

      Two earlier variants were measured and rejected: marking the registration ARPSYSTEMCOMPONENT=1
      hid it from Apps & Features completely (0 visible entries, so no GUI uninstall), and writing the
      Uninstall key by hand as an HKCU facade did not make it visible either, because the shell's
      installed-programs list does not show that hand-written key.
    -->

    <!--
      Add/Remove Programs "InstallLocation". Windows Installer reads ARPINSTALLLOCATION after
      CostFinalize, so the value has to be resolved at run time instead of being frozen at build
      time (a literal "[INSTALLFOLDER]" property value would be installed verbatim).
    -->
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" Sequence="both" />

    <!-- Finish dialog: opt-in "Start Overlyric now" checkbox, checked by default. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start Overlyric now" />

    <!--
      Launching the app from the Finish page. A type-18 "EXE from the File table" action looks like
      the obvious choice, but it is serviced out of process: from the UI sequence it returns 1631 and
      nothing starts (measured in the wizard's log). This type-34 action runs cmd.exe in the client
      process instead and asks the shell to start the installed exe, which is the same shape as the
      REMOVEDATA action below, whose execution is confirmed in the uninstall logs.
    -->
    <CustomAction Id="LaunchOverlyric"
                  Directory="SystemFolder"
                  ExeCommand="cmd.exe /C start &quot;&quot; &quot;[INSTALLFOLDER]Overlyric.exe&quot;"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <!--
      Overlyric is a tray application with no main window, so a polite WM_CLOSE is posted and,
      because the process does not have to honour it, it is terminated after a short timeout.
      No prompts and no reboot prompt: installing or upgrading over a running instance always
      completes deterministically instead of hanging on FilesInUse or requesting a reboot.
    -->
    <util:CloseApplication Id="CloseOverlyric"
                           Target="Overlyric.exe"
                           CloseMessage="yes"
                           PromptToContinue="no"
                           Timeout="5"
                           TerminateProcess="0"
                           RebootPrompt="no" />

    <!--
      REMOVEDATA support. Uninstalling keeps %LOCALAPPDATA%\Overlyric (user config, cache and
      versions.json) unless the uninstall command line contains REMOVEDATA=1. The deferred
      type-34 action below runs as the user after RemoveFiles and deletes the folder tree.

      util:RemoveFolderEx cannot be used for this: WiX schedules WixRemoveFoldersEx at sequence
      799, before CostFinalize resolves [LocalAppDataFolder], so the folder property is always
      empty there ("Missing folder property" at runtime). A deferred action is formatted at
      scheduling time instead, after directory properties are resolved.
    -->
    <CustomAction Id="RemoveOverlyricUserData"
                  Directory="SystemFolder"
                  ExeCommand="cmd.exe /C if exist &quot;[LocalAppDataFolder]Overlyric&quot; rmdir /S /Q &quot;[LocalAppDataFolder]Overlyric&quot;"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!--
        Fires only for an explicit uninstall (REMOVE=ALL) that asked for REMOVEDATA=1. The
        NOT UPGRADINGPRODUCTCODE guard keeps it from deleting user data while a major upgrade
        removes the previous version, and the LocalAppDataFolder term keeps the action out of
        the script entirely if the directory property is somehow empty (so the command line can
        never degrade into a relative or empty rmdir). Impersonate="yes" makes the deferred
        action run as the installing user, and the command itself is guarded with "if exist".
      -->
      <Custom Action="RemoveOverlyricUserData" After="RemoveFiles" Condition="REMOVEDATA=1 AND (REMOVE=&quot;ALL&quot; OR REMOVE~=&quot;ALL&quot;) AND NOT UPGRADINGPRODUCTCODE AND LocalAppDataFolder" />
    </InstallExecuteSequence>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Overlyric" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- ===================================================== features -->

    <Feature Id="MainFeature"
             Title="Overlyric"
             Description="The Overlyric application, its Start Menu shortcut and uninstall support."
             Level="1"
             AllowAbsent="no">
      <ComponentRef Id="ApplicationFiles" />
      <ComponentGroupRef Id="PayloadExtras" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Installed by default; deselecting the feature removes the HKCU Run value. -->
    <Feature Id="StartWithWindows"
             Title="Start Overlyric when I sign in"
             Description="Adds Overlyric to this user's Windows startup list (HKCU Run key)."
             Level="1">
      <ComponentRef Id="RunAtStartup" />
    </Feature>

    <!-- Opt-in: not installed by default (Level 2 > INSTALLLEVEL 1). -->
    <Feature Id="DesktopShortcut"
             Title="Desktop shortcut"
             Description="Creates a shortcut to Overlyric on the desktop."
             Level="2">
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

    <!--
      Dialog set: the stock WiX dialogs (feature tree, so StartWithWindows can be deselected and
      the desktop shortcut opted into) wired into a licence-free flow. The stock WixUI_FeatureTree
      set inserts a EULA page (Welcome -> License -> Customize); this repository has no LICENSE
      file and no licence text may be invented, so the set below reuses the same stock dialogs and
      goes Welcome -> Customize directly. See the OverlyricUI fragment at the end of this file.
    -->
    <ui:WixUI Id="OverlyricUI" />

  </Package>

  <!-- ===================================================== payload -->

  <Fragment>
    <!--
      The published executable. It is authored explicitly (rather than by the generated
      Payload.wxs) so that util:CloseApplication can be attached to it: an install or upgrade
      over a running instance closes the tray process instead of failing or forcing a reboot.
    -->
    <Component Id="ApplicationFiles" Directory="INSTALLFOLDER" Guid="{7E8B4FF3-175A-46A7-85DA-326DC5E024D7}">
      <File Id="OverlyricExe" Source="$(var.PublishDir)\Overlyric.exe" />
      <!--
        Per-user components must key off HKCU rather than a file in the user profile (ICE38), so
        the component identity follows this per-user registry value. The two RemoveFolder entries
        make uninstall clean up the install folder and the %LOCALAPPDATA%\Programs folder we
        created (RemoveFolder only deletes them when they are empty, ICE64).
      -->
      <RegistryValue Root="HKCU" Key="Software\Overlyric\Installer" Name="ApplicationFiles" Type="integer" Value="1" KeyPath="yes" />
      <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      <RemoveFolder Id="RemoveProgramsFolder" On="uninstall" Directory="ProgramsFolder" />
    </Component>
  </Fragment>

  <!-- ===================================================== shortcuts -->

  <Fragment>
    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="{022D302F-5384-47B5-925C-FD6F1A08A24B}">
      <Shortcut Id="StartMenuLink"
                Name="Overlyric"
                Description="Overlyric"
                Target="[INSTALLFOLDER]Overlyric.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\Overlyric\Installer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="{9252B91B-4160-4020-98CD-81F7D1414F7D}">
      <Shortcut Id="DesktopLink"
                Name="Overlyric"
                Description="Overlyric"
                Target="[INSTALLFOLDER]Overlyric.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\Overlyric\Installer" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- ===================================================== per-user registry state -->

  <Fragment>
    <Component Id="RunAtStartup" Directory="INSTALLFOLDER" Guid="{45BAAD20-C2A2-4D6A-ADB2-E043535CDC7D}">
      <RegistryValue Id="RunValue"
                     Root="HKCU"
                     Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="Overlyric"
                     Type="string"
                     Value="&quot;[INSTALLFOLDER]Overlyric.exe&quot;"
                     KeyPath="yes" />
    </Component>

    <!--
      Deliberately no hand-written Add/Remove Programs component. Windows Installer registers the
      product's own Uninstall key (DisplayName, DisplayVersion, Publisher, UninstallString,
      ModifyPath, and an EstimatedSize derived from the File table) and that is the entry the shell
      shows; a hand-kept copy was measured to be invisible to Programs and Features and to leave
      stale values behind after an upgrade. ARPINSTALLLOCATION above supplies the one value the
      installer does not derive on its own, InstallLocation.
    -->


  </Fragment>


  <!-- ===================================================== licence-free dialog set -->

  <Fragment>
    <!--
      A dialog set in the same shape the WiX UI extension's own sets use: reference the stock
      dialogs, publish the inter-dialog flow, and pull in WixUI_Common for the shared dialogs,
      error handling and progress/UI sequence. The only difference from WixUI_FeatureTree is that
      the license page is not part of the flow (and not even referenced).
    -->
    <UI Id="file OverlyricUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />

      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="CustomizeDlg" />
      <DialogRef Id="VerifyReadyDlg" />
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <DialogRef Id="MaintenanceTypeDlg" />
      <DialogRef Id="ExitDialog" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
      <!-- Optional "Start Overlyric now" checkbox from the Finish dialog. -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchOverlyric" Order="10"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed and &amp;MainFeature = 3" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="CustomizeDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="1" Condition="Installed AND PATCH" />
      <!-- WelcomeDlg.wxs already publishes the [WixUI_InstallMode] Update path for patches. -->

      <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="1" Condition="Installed" />
      <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="CustomizeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="1" />

      <Publish Dialog="BrowseDlg" Control="OK" Event="SetTargetPath" Value="[_BrowseProperty]" Order="3" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="EndDialog" Value="Return" Order="4" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="CustomizeDlg" Order="1" Condition="NOT Installed OR WixUI_InstallMode = &quot;Change&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="3" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" Order="1" />
      <Publish Dialog="MaintenanceTypeDlg" Control="ChangeButton" Event="NewDialog" Value="CustomizeDlg" Order="1" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" Order="1" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" Order="1" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" Order="1" />

      <UIRef Id="WixUI_Common" />
    </UI>
  </Fragment>

  <?foreach WIXUIARCH in X86;X64;A64 ?>
  <Fragment>
    <!-- Per-architecture entry point for the dialog set, mirroring how the WiX UI sets are built. -->
    <UI Id="OverlyricUI_$(WIXUIARCH)">
      <UIRef Id="OverlyricUI" />
    </UI>
  </Fragment>
  <?endforeach?>
</Wix>










