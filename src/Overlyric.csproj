<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Overlyric</RootNamespace>
    <AssemblyName>Overlyric</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>

    <!-- Ship as a single self-contained native executable: no .NET runtime install,
         no JIT warm-up, and a small steady-state working set. -->
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StripSymbols>true</StripSymbols>
    <TrimMode>full</TrimMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.4.0</Version>

    <!--
      The icon every Windows surface reads: Explorer and the taskbar (from the executable's
      resources), the notification area, Alt+Tab, and the MSI's Add/Remove Programs entry.
      Assets\Overlyric.ico is rendered from Assets\Overlyric.svg by tools\make-icon.py.
    -->
    <ApplicationIcon>Assets\Overlyric.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Keep the garbage collector on a short leash. Overlyric is a background overlay: it would
      rather give back memory promptly than hold a large heap it will never need. Without this the
      GC lets the media-session polling allocations accumulate and the working set drifts past
      100 MB; with it the footprint sits around 88 MB and is stable. Measured CPU is unchanged.
    -->
    <RuntimeHostConfigurationOption Include="System.GC.Conserve" Value="5" />
  </ItemGroup>

</Project>
