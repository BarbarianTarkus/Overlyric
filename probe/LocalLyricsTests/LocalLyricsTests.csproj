<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LocalLyricsTests</AssemblyName>
    <RootNamespace>Overlyric.LocalLyricsTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The store, the selection file and the text codec are pure .NET; only the file dialogs and
