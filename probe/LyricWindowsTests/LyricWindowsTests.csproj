    <Compile Include="..\..\src\App\LyricText.cs" />
    <Compile Include="..\..\src\Lyrics\LocalLyricsStore.cs" />
    <Compile Include="..\..\src\Lyrics\LrcParser.cs" />
    <Compile Include="..\..\src\Lyrics\LyricLine.cs" />
    <Compile Include="..\..\src\Lyrics\LyricTextCodec.cs" />
    <Compile Include="..\..\src\Lyrics\LyricsCandidate.cs" />
    <Compile Include="..\..\src\Lyrics\LyricsResult.cs" />
  </ItemGroup>

</Project>
