<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ThemeTests</AssemblyName>
    <RootNamespace>Overlyric.ThemeTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The config-to-theme mapping is pure apart from the colour type, so it can be checked
         without a window, a device or a settings click. -->
    <Compile Include="..\..\src\App\AppConfig.cs" />
    <Compile Include="..\..\src\App\InstanceScope.cs" />
    <Compile Include="..\..\src\App\MonitorSettings.cs" />
    <Compile Include="..\..\src\Media\AudioOutput.cs" />
    <Compile Include="..\..\src\Media\PresenceRules.cs" />
    <Compile Include="..\..\src\Media\SourceSelector.cs" />
    <Compile Include="..\..\src\Media\TimingProfiles.cs" />
    <Compile Include="..\..\src\Overlay\OverlayAnchor.cs" />
    <Compile Include="..\..\src\Overlay\OverlayNotice.cs" />
    <Compile Include="..\..\src\Overlay\OverlayTheme.cs" />
  </ItemGroup>

</Project>
